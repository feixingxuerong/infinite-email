# Auto Register ChatGPT Configuration
# Copy this to .env.local and fill in your credentials

# ============================================
# Configuration Priority:
# 1. tools/auto-register-chatgpt/.env.local (highest)
# 2. Project root .env.local
# ============================================

# Worker API Configuration (for generating aliases)
WORKER_URL=http://localhost:8787
ADMIN_TOKEN=your-admin-token-here

# IMAP Configuration (for fetching verification codes)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
IMAP_TLS=true

# Domain for email aliases
DOMAIN=1secmail.com
