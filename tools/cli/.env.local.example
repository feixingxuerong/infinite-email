# Infinite Email CLI Configuration
# Copy this to .env.local and fill in your credentials

# Required: Worker API settings
WORKER_URL=https://your-worker.workers.dev
ADMIN_TOKEN=your-admin-secret-token

# Optional: Your domain (used for full address generation)
# DOMAIN=yourdomain.com

# IMAP Configuration (required for 'fetch' command)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
IMAP_TLS=true
